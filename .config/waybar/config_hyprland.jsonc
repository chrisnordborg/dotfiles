{
    "output": "DP-2",
	  "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 4,

//    "modules-left": [
//      "hyprland/workspaces",
//			"hyprland/window"
//    ],

    "modules-center": [
  	"custom/timer",
		"custom/workspace1",
		"custom/workspace2",
		"custom/workspace3",
		"custom/workspace4",
		"custom/workspace5",
    "clock",
		"custom/workspace6",
		"custom/workspace7",
		"custom/workspace8",
		"custom/workspace9",
		"custom/workspace10",
		"custom/pomodoro",
    "custom/backup" 
    ],

    "modules-right": [
			"cpu",
			"memory",
   		/*     "disk", */
			"network",
      "battery",
      "backlight",
      "pulseaudio",
      "pulseaudio#microphone",
			"custom/systemprompt",
			"tray"
    ],

//    "hyprland/window": {
//        "format": " 󰣇 {}"
//    },

"custom/workspace1": {
    "exec": "bash ~/.config/scripts/toolbar/workspace.sh 1",
    "return-type": "json",
    "interval": 0.2,
    "on-click": "hyprctl dispatch workspace 1"
},

"custom/workspace2": {
    "exec": "bash ~/.config/scripts/toolbar/workspace.sh 2",
    "return-type": "json",
    "interval": 0.2,
    "on-click": "hyprctl dispatch workspace 2"
},

"custom/workspace3": {
    "exec": "bash ~/.config/scripts/toolbar/workspace.sh 3",
    "return-type": "json",
    "interval": 0.2,
    "on-click": "hyprctl dispatch workspace 3"
},

"custom/workspace4": {
    "exec": "bash ~/.config/scripts/toolbar/workspace.sh 4",
    "return-type": "json",
    "interval": 0.2,
    "on-click": "hyprctl dispatch workspace 4"
},

"custom/workspace5": {
    "exec": "bash ~/.config/scripts/toolbar/workspace.sh 5",
    "return-type": "json",
    "interval": 0.2,
    "on-click": "hyprctl dispatch workspace 5"
},

"custom/workspace6": {
    "exec": "bash ~/.config/scripts/toolbar/workspace.sh 6",
    "return-type": "json",
    "interval": 0.2,
    "on-click": "hyprctl dispatch workspace 6"
},

"custom/workspace7": {
    "exec": "bash ~/.config/scripts/toolbar/workspace.sh 7",
    "return-type": "json",
    "interval": 0.2,
    "on-click": "hyprctl dispatch workspace 7"
},

"custom/workspace8": {
    "exec": "bash ~/.config/scripts/toolbar/workspace.sh 8",
    "return-type": "json",
    "interval": 0.2,
    "on-click": "hyprctl dispatch workspace 8"
},

"custom/workspace9": {
    "exec": "bash ~/.config/scripts/toolbar/workspace.sh 9",
    "return-type": "json",
    "interval": 0.2,
    "on-click": "hyprctl dispatch workspace 9"
},

"custom/workspace10": {
    "exec": "bash ~/.config/scripts/toolbar/workspace.sh 10",
    "return-type": "json",
    "interval": 0.2,
    "on-click": "hyprctl dispatch workspace 10"
},

    
    "custom/timer": {
      "exec": "cat /tmp/status_bar_timer.txt",
      "interval": 1,
      "format": "⏱ {text} ",
      "on-click": "~/.config/scripts/toolbar/timer.sh"
    },

    "custom/pomodoro": {
        "exec": "cat /tmp/pomodoro_timer.txt",
        "interval": 1,
        "format": " ⏱ {text} ",
        "return-type": "json",
        "on-click": "~/.config/scripts/toolbar/pomodoro.sh"
    },

		"custom/backup": {
  			"return-type": "json",
  			"exec": "cat /tmp/backup-status.json 2>/dev/null",
  			//"exec": "cat /tmp/backup-status.json 2>/dev/null || echo '{\"text\":\"Idle\",\"class\":\"idle\"}'"
				"interval": 0.5
		},

		//"custom/backup": {
  	//		"return-type": "json",
  	//		"exec": "cat /tmp/backup-status.json",
  	//		"interval": 0.5 
		//},

    "clock": {
        // English/American format (20:05:00 AM).
	//"format": "{:%A    %B-%d-%Y    %I:%M:%S %p}",
        // Swedish format
	"format": "{:%H:%M}",
	"format-alt": "{:%A<span size='12000'> |  %Y-%m-%d | ⏱%H:%M:%S</span>} ",
	//"format-alt": "{:<span size='11500'>%A</span> | <span size='9000'> %Y-%m-%d |  %H:%M:%S</span>}",
	//"format-alt": "<span size='11000'>{:%A}</span> | <span size='9000'> {:%Y-%m-%d} |  {:%H:%M:%S}</span>",



	"interval": 1,
        "rotate": 0,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#a6adc8'><b>{}</b></span>",
                "weekdays": "<span color='#a6adc8'><b>{}</b></span>",
                "today": "<span color='#a6adc8'><b>{}</b></span>",
                "days": "<span color='#555869'><b>{}</b></span>"
            }
        }
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-",
        "min-length": 6
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "pulseaudio": { 
        "format": "{icon} {volume}%",
        "tooltip": false,
        "format-muted": "  Muted",
        "on-click": "pamixer -t",
        "on-scroll-up": "pamixer -i 1",
        "on-scroll-down": "pamixer -d 1",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["","", "", ""]
        }
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "  Muted",
        "on-click": "pamixer --default-source -t",
        "on-scroll-up": "pamixer --default-source -i 5",
        "on-scroll-down": "pamixer --default-source -d 5",
        "scroll-step": 5
    },

    "memory": {
        "states": {
            "c": 90, // critical
            "h": 60, // high
            "m": 30 // medium
        },
        "interval": 10,
        "format": "󰾆 {used}GB",
        "format-m": "󰾅 {used}GB",
        "format-h": "󰓅 {used}GB",
        "format-c": " {used}GB",
        "format-alt": "󰾆 {percentage}%",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": "󰾆 {percentage}%\n {used:0.1f}GB/{total:0.1f}GB"
    },

    "cpu": {
        "interval": 10,
        "format": "󰍛 {usage}%",
        "format-alt": "{icon0}{icon1}{icon2}{icon3}",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    },

    "network": {
        "tooltip": true,
        "format-wifi": " ",
        "format-ethernet": "󰈀 ",
        "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰖪 ",
        "tooltip-format-disconnected": "Disconnected",
	"format-alt": "<span foreground='#ffffff'>|| </span><span foreground='#99ffdd'> {bandwidthDownBytes}  </span><span foreground='#ffcc66'> {bandwidthUpBytes}</span><span foreground='#ffffff'> ||</span>",
       "interval": 2
    },
    "custom/systemprompt": {
        "format": "⏻",
	"format-size": 20,
        "on-click": "wlogout"
    },

    "tray": {
        "icon-size": 13,
        "spacing": 10
    }
}
